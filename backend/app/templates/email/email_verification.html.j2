[% set subject = subject or 'Verifica tu correo electrónico' %]
[% set badge_text = 'Verificación de correo' %]
[% set badge_color = '#1565C0' %]
[% set cta_text = 'Verificar correo' %]
[% set security_note = 'Si no solicitaste esta verificación, puedes ignorar este mensaje con seguridad. Tu cuenta permanecerá inactiva hasta confirmar el correo.' %]
[% set security_note_bg = '#eaf2f8' %]
[% set security_note_color = '#1565C0' %]
[% if not body_html %]
[% set body_html %]
<h1 style="font-size:20px;margin:0 0 8px 0;color:#1d1d1f;">Hola {{nombre_usuario}},</h1>
<p style="font-size:14px;line-height:1.6;margin:0;color:#3c3c43;">
  Para completar tu registro en <strong>[[ tenant_name ]]</strong>, necesitamos verificar tu dirección de
  correo electrónico. Usa el botón de abajo para confirmarla.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e5ea;border-radius:6px;margin-top:20px;">
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;width:42%;border-bottom:1px solid #e5e5ea;">Sistema</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">[[ tenant_name ]]</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Correo a verificar</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{usuario_email}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;">Fecha de solicitud</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;">{{fecha_evento}}</td>
  </tr>
</table>
<p style="font-size:12px;color:#888888;margin:16px 0 0;">Este enlace expirará en 24 horas.</p>
[% endset %]
[% endif %]
[%- include "email_base_unified.html.j2" %]
