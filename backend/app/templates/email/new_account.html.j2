[% set subject = subject or 'Cuenta creada exitosamente' %]
[% set badge_text = 'Alta de usuario' %]
[% set badge_color = '#2E7D32' %]
[% set cta_text = 'Iniciar sesión' %]
[% set security_note = '¿No reconoces esta cuenta o no la solicitaste? Contacta de inmediato a <a href="mailto:{{contacto_soporte}}" style="color:#2E7D32;">{{contacto_soporte}}</a>.' %]
[% set security_note_bg = '#f5f8f0' %]
[% set security_note_color = '#2E7D32' %]
[% if not body_html %]
[% set body_html %]
<h1 style="font-size:20px;margin:0 0 8px 0;color:#1d1d1f;">Hola {{nombre_usuario}},</h1>
<p style="font-size:14px;line-height:1.6;margin:0;color:#3c3c43;">
  Se ha creado tu cuenta en <strong>[[ tenant_name ]]</strong>. A continuación encontrarás los datos de
  acceso y los pasos para ingresar por primera vez.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e5ea;border-radius:6px;margin-top:20px;">
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;width:42%;border-bottom:1px solid #e5e5ea;">Sistema</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">[[ tenant_name ]]</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Usuario / login</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{usuario_login}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Contraseña temporal</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{password_temporal}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Rol asignado</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{rol_asignado}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Vigencia de contraseña temporal</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{fecha_expiracion_password}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;">Fecha de creación</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;">{{fecha_evento}}</td>
  </tr>
</table>
<p style="font-size:12px;color:#888888;margin:16px 0 0;">Se te pedirá cambiar tu contraseña temporal en tu primer inicio de sesión.</p>
[% endset %]
[% endif %]
[%- include "email_base_unified.html.j2" %]
