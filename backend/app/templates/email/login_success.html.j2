[% set subject = subject or 'Nuevo inicio de sesión' %]
[% set badge_text = 'Inicio de sesión' %]
[% set badge_color = '#2E7D32' %]
[% set cta_text = None %]
[% set cta_url = None %]
[% set security_note = '¿No reconoces este inicio de sesión? Cambia tu contraseña de inmediato y contacta a <a href="mailto:{{contacto_soporte}}" style="color:#2E7D32;">{{contacto_soporte}}</a>.' %]
[% set security_note_bg = '#eef7ee' %]
[% set security_note_color = '#2E7D32' %]
[% if not body_html %]
[% set body_html %]
<h1 style="font-size:20px;margin:0 0 8px 0;color:#1d1d1f;">Hola {{nombre_usuario}},</h1>
<p style="font-size:14px;line-height:1.6;margin:0;color:#3c3c43;">
  Se inició sesión en tu cuenta de <strong>[[ tenant_name ]]</strong>.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e5ea;border-radius:6px;margin-top:20px;">
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;width:42%;border-bottom:1px solid #e5e5ea;">Sistema</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">[[ tenant_name ]]</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Usuario / login</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{usuario_login}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Fecha y hora</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{fecha_evento}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;">IP de origen</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;">{{ip_origen}}</td>
  </tr>
</table>
[% endset %]
[% endif %]
[%- include "email_base_unified.html.j2" %]
