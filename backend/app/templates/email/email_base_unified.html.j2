<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[[ subject or 'Notificación' ]]</title>
</head>
<body style="margin:0;padding:0;background-color:#f2f3f5;font-family:Arial, Helvetica, sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f2f3f5;padding:24px 0;">
<tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:6px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">

  [% if logo_url %]
  <tr><td align="center" style="padding:24px 32px 8px;background-color:#ffffff;">
    <img src="[[ logo_url ]]" alt="[[ tenant_name or 'Organización' ]]"
         style="max-height:72px;max-width:260px;display:block;border:0;outline:0;" />
  </td></tr>
  [% elif logo_base64 %]
  <tr><td align="center" style="padding:24px 32px 8px;background-color:#ffffff;">
    <img src="[[ logo_base64 ]]" alt="[[ tenant_name or 'Organización' ]]"
         style="max-height:72px;max-width:260px;display:block;border:0;outline:0;" />
  </td></tr>
  [% endif %]

  <tr><td height="4" style="background-color:[[ theme.primary_color ]];font-size:0;line-height:0;mso-line-height-rule:exactly;">&nbsp;</td></tr>

  [% if badge_text %]
  <tr><td style="padding:24px 32px 0 32px;">
    <span style="display:inline-block;background-color:[[ badge_color or theme.primary_color ]];color:#ffffff;font-size:12px;font-weight:bold;letter-spacing:0.5px;padding:6px 14px;border-radius:14px;text-transform:uppercase;font-family:Arial,Helvetica,sans-serif;">
      [[ badge_text ]]
    </span>
  </td></tr>
  [% endif %]

  <tr><td style="padding:20px 32px 8px;font-size:15px;line-height:1.65;color:#333333;font-family:Arial,Helvetica,sans-serif;">
    [[ body_html ]]
  </td></tr>

  [% if cta_url %]
  <tr><td align="center" style="padding:8px 32px 24px;">
    <table border="0" cellpadding="0" cellspacing="0">
      <tr><td align="center" style="background-color:[[ theme.primary_color ]];border-radius:6px;mso-padding-alt:0;">
        <a href="[[ cta_url ]]" target="_blank"
           style="display:inline-block;padding:12px 28px;font-family:Arial,Helvetica,sans-serif;font-size:14px;
                  font-weight:bold;color:#ffffff;text-decoration:none;border-radius:6px;
                  background-color:[[ theme.primary_color ]];">
          [[ cta_text or 'Acceder' ]]
        </a>
      </td></tr>
    </table>
  </td></tr>
  [% endif %]

  [% if security_note %]
  <tr><td style="padding:0 32px 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:[[ security_note_bg or '#fff8f0' ]];border-left:4px solid [[ security_note_color or theme.primary_color ]];border-radius:4px;">
      <tr><td style="padding:12px 16px;font-size:12px;line-height:1.6;color:#3c3c43;font-family:Arial,Helvetica,sans-serif;">
        [[ security_note ]]
      </td></tr>
    </table>
  </td></tr>
  [% endif %]

  <tr><td style="height:1px;background-color:#eeeeee;font-size:0;line-height:0;">&nbsp;</td></tr>

  [% if logo_bottom_url %]
  <tr><td align="center" style="padding:20px 32px 4px;background-color:#f9f9f9;">
    <img src="[[ logo_bottom_url ]]" alt="Plataforma de Administración"
         style="max-height:40px;max-width:200px;display:block;border:0;outline:0;" />
  </td></tr>
  [% elif logo_bottom_base64 %]
  <tr><td align="center" style="padding:20px 32px 4px;background-color:#f9f9f9;">
    <img src="[[ logo_bottom_base64 ]]" alt="Plataforma de Administración"
         style="max-height:40px;max-width:200px;display:block;border:0;outline:0;" />
  </td></tr>
  [% endif %]

  <tr><td align="center" style="padding:12px 32px 20px;background-color:#f9f9f9;font-family:Arial,Helvetica,sans-serif;">
    <p style="font-size:11px;color:#888888;margin:0 0 4px;line-height:1.5;">Este es un mensaje automático, por favor no respondas a este correo.</p>
    <p style="font-size:11px;color:#888888;margin:0 0 4px;line-height:1.5;">Para soporte escríbenos a {{contacto_soporte}}</p>
    <p style="font-size:11px;color:#888888;margin:0;line-height:1.5;">© {{anio}} {{empresa_nombre}}. Todos los derechos reservados.</p>
    [% if theme.email_footer_text %]
    <p style="font-size:10px;color:#aaaaaa;margin:6px 0 0;line-height:1.5;">[[ theme.email_footer_text ]]</p>
    [% endif %]
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
