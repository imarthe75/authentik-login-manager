[% set subject = subject or 'Restablecer contraseña' %]
[% set badge_text = 'Cambio de contraseña' %]
[% set badge_color = '#EF6C00' %]
[% set cta_text = 'Restablecer contraseña' %]
[% set security_note = '<strong>¿No solicitaste este cambio?</strong> Si tú no realizaste esta solicitud, tu cuenta podría estar en riesgo. Contacta de inmediato a <a href="mailto:{{contacto_soporte}}" style="color:#EF6C00;">{{contacto_soporte}}</a> y no hagas clic en el enlace de arriba.' %]
[% set security_note_bg = '#fff8f0' %]
[% set security_note_color = '#EF6C00' %]
[% if not body_html %]
[% set body_html %]
<h1 style="font-size:20px;margin:0 0 8px 0;color:#1d1d1f;">Hola {{nombre_usuario}},</h1>
<p style="font-size:14px;line-height:1.6;margin:0;color:#3c3c43;">
  Recibimos una solicitud para restablecer la contraseña de tu cuenta en <strong>[[ tenant_name ]]</strong>.
  Usa el botón de abajo para crear una nueva contraseña. Si no realizaste esta solicitud, ignora este mensaje.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e5ea;border-radius:6px;margin-top:20px;">
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;width:42%;border-bottom:1px solid #e5e5ea;">Sistema</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">[[ tenant_name ]]</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Usuario / login</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{usuario_login}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Fecha y hora de solicitud</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{fecha_evento}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;">IP de origen</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;">{{ip_origen}}</td>
  </tr>
</table>
<p style="font-size:12px;color:#888888;margin:16px 0 0;">Este enlace es válido por {{enlace_expiracion_texto}} a partir del momento en que se generó.</p>
[% endset %]
[% endif %]
[%- include "email_base_unified.html.j2" %]
