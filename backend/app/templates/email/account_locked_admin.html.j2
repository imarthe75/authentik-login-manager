[% set subject = subject or 'Tu cuenta fue bloqueada' %]
[% set badge_text = 'Cuenta bloqueada' %]
[% set badge_color = '#C62828' %]
[% set cta_text = 'Contactar a soporte' %]
[% set security_note = '¿Tienes dudas sobre este bloqueo? Contacta de inmediato a <a href="mailto:{{contacto_soporte}}" style="color:#C62828;">{{contacto_soporte}}</a>.' %]
[% set security_note_bg = '#fdf2f2' %]
[% set security_note_color = '#C62828' %]
[% if not body_html %]
[% set body_html %]
<h1 style="font-size:20px;margin:0 0 8px 0;color:#1d1d1f;">Hola {{nombre_usuario}},</h1>
<p style="font-size:14px;line-height:1.6;margin:0;color:#3c3c43;">
  Un administrador bloqueó tu cuenta en <strong>[[ tenant_name ]]</strong>. Mientras el bloqueo esté activo, no
  podrás iniciar sesión.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e5e5ea;border-radius:6px;margin-top:20px;">
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;width:42%;border-bottom:1px solid #e5e5ea;">Sistema</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">[[ tenant_name ]]</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Usuario / login</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{usuario_login}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;border-bottom:1px solid #e5e5ea;">Fecha y hora del bloqueo</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;border-bottom:1px solid #e5e5ea;">{{fecha_evento}}</td>
  </tr>
  <tr>
    <td style="padding:10px 14px;font-size:13px;color:#6e6e73;">Realizado por</td>
    <td style="padding:10px 14px;font-size:13px;color:#1d1d1f;">{{realizado_por}}</td>
  </tr>
</table>
<p style="font-size:12px;color:#888888;margin:16px 0 0;">Este bloqueo NO se libera automáticamente — requiere que un administrador reactive la cuenta.</p>
[% endset %]
[% endif %]
[%- include "email_base_unified.html.j2" %]
