// Apps con flow de registro dedicado (uno por app_slug, ver
// core-casmarts/casmarts-app-enrollment.yaml) — cada uno asigna
// automáticamente el grupo de esa app al usuario nuevo. Si client_id no está
// en esta lista (app global o desconocida), se deja el link de registro por
// defecto de Authentik sin tocar.
var ENROLLMENT_APP_SLUGS = ['starter', 'consulta-smart', 'idp-smart', 'centinela-ai', 'kiwi', 'plane'];

function rewriteEnrollLink(node) {
    if (!node || node.tagName !== 'A') return;
    var href = node.getAttribute('href');
    if (!href || href.indexOf('/if/flow/default-source-enrollment/') === -1) return;
    var clientId = new URL(window.location.href).searchParams.get('client_id') || '';
    if (ENROLLMENT_APP_SLUGS.indexOf(clientId) === -1) return;
    node.setAttribute('href', href.replace('/if/flow/default-source-enrollment/', '/if/flow/enrollment-' + clientId + '/'));
}

function translateNode(node) {
    if (!node) return;
    if (node.nodeType === 3) {
        var txt = node.nodeValue.trim().toLowerCase().replace(/\s+/g, ' ');
        for (var key in TRANSLATIONS) {
            if (txt === key || txt === key.replace(/\.$/, '') || txt.replace(/\.$/, '') === key) {
                node.nodeValue = TRANSLATIONS[key];
                break;
            }
        }
    } else if (node.nodeType === 1) {
        rewriteEnrollLink(node);
        if (node.placeholder) {
            var pl = node.placeholder.trim().toLowerCase();
            if (TRANSLATIONS[pl]) {
                node.placeholder = TRANSLATIONS[pl];
            }
        }
        for (var i = 0; i < node.childNodes.length; i++) {
            translateNode(node.childNodes[i]);
        }
        if (node.shadowRoot) {
            translateNode(node.shadowRoot);
        }
    }
}

function setupErrorCleaner(shadow) {
    // Intencionalmente SIN EFECTO. Antes esta función ocultaba TODA alerta/error
    // (.pf-c-form__helper-text, [class*="error"], [class*="alert"]) con
    // display:none inline !important en cada evento input/focusin. El campo de
    // contraseña se autoenfoca al re-renderizar el stage tras un login fallido,
    // así que el focusin disparaba clearError y HACÍA DESAPARECER el mensaje de
    // error ("Error de autenticación") apenas aparecía — por eso se veía el
    // recuadro rojo sin texto la 1ª vez y nada la 2ª. Un display:none inline
    // !important puesto por JS NO puede revertirse desde ninguna hoja de estilo,
    // por lo que las exclusiones :not(...) del CSS no servían de nada frente a él.
    // Los errores ahora se limpian solos cuando Authentik re-renderiza el stage en
    // el siguiente envío. Ver memoria flowhtml-css-recurring-regressions (regla #1).
    return;
}

// Reescribe el botón "Ir al inicio" del stage de acceso denegado y restaura el
// padding inferior del card. AccessDeniedStage.ts renderiza:
//   <a class="pf-c-button pf-m-primary pf-m-block" href=${challenge.flowInfo.cancelUrl}>
// donde cancelUrl reenvía al flujo de autenticación con next=/application/o/authorize/…
// Como el usuario YA está autenticado, eso rebota de inmediato al authorize denegado
// => LOOP. Reescribimos el href a un LOGOUT (default-invalidation-flow) que cierra
// sesión y devuelve al login — el usuario puede reintentar con otra cuenta.
// El botón vive en el shadow root del stage; el chrome/padding en <ak-flow-card>.
function setupAccessDeniedStage(root) {
    if (!root || !root.querySelectorAll) return;
    var LOGOUT_URL = '/if/flow/default-invalidation-flow/';
    root.querySelectorAll('a.pf-c-button, a.pf-m-primary').forEach(function(a) {
        if (a.getAttribute('href') !== LOGOUT_URL) a.setAttribute('href', LOGOUT_URL);
    });
    // La var --pf-c-login__main-body--PaddingBottom:0 (fijada en ak-flow-executor)
    // se HEREDA al shadow de ak-flow-card y deja el botón pegado al borde inferior.
    // La restauramos SOLO en este card, sin afectar al login.
    var card = root.querySelector('ak-flow-card');
    if (card) {
        card.style.setProperty('--pf-c-login__main-body--PaddingBottom', '1.5rem');
        card.style.setProperty('--pf-c-login__main--PaddingBottom', '1.5rem');
    }
}

function inject(root){
    if(!root||!root.appendChild)return;
    var hostTag = (root.host && root.host.tagName) ? root.host.tagName.toLowerCase() : '';
    if (root.host && hostTag !== 'ak-flow-executor' && hostTag.indexOf('ak-stage-') !== 0) {
        return;
    }
    var ex=root.querySelector&&root.querySelector('#cs-intercept');
    if(ex){
        ex.textContent=ECSS;
    } else {
        var s=document.createElement('style');
        s.id='cs-intercept';
        s.textContent=ECSS;
        root.appendChild(s);
        new MutationObserver(function(ms){
            ms.forEach(function(m){
                if (m.type === 'characterData') {
                    translateNode(m.target);
                } else {
                    m.addedNodes.forEach(function(n){
                        translateNode(n);
                        if(n.nodeType!==1)return;
                        if(n.shadowRoot)inject(n.shadowRoot);
                        if(n.querySelectorAll)n.querySelectorAll('*').forEach(function(e){if(e.shadowRoot)inject(e.shadowRoot);});
                    });
                    setupErrorCleaner(root);
                    if (hostTag === 'ak-stage-access-denied') {
                        setupAccessDeniedStage(root);
                    }
                }
            });
        }).observe(root,{childList:true,subtree:true,characterData:true});
    }
    if(root.querySelectorAll) {
        root.querySelectorAll('*').forEach(function(e){
            if(e.shadowRoot) inject(e.shadowRoot);
        });
    }
    translateNode(root);
    setupErrorCleaner(root);
    if (hostTag === 'ak-stage-access-denied') {
        setupAccessDeniedStage(root);
    }
}

// Interceptar customElements.define para parchear connectedCallback ANTES del primer render
if(typeof customElements!=='undefined'){
    var _def=customElements.define.bind(customElements);
    customElements.define=function(name,ctor,opts){
        if(name&&name.indexOf('ak-')===0&&ctor&&ctor.prototype){
            var _cc=ctor.prototype.connectedCallback;
            ctor.prototype.connectedCallback=function(){
                var self=this;
                if(self.shadowRoot)inject(self.shadowRoot);
                var r=_cc?_cc.apply(self,arguments):undefined;
                if(self.shadowRoot)inject(self.shadowRoot);
                if(typeof Promise!=='undefined')Promise.resolve().then(function(){
                    if(self.shadowRoot)inject(self.shadowRoot);
                });
                return r;
            };
        }
        return _def(name,ctor,opts);
    };
}

// Observer en document para elementos que se agreguen después
new MutationObserver(function(ms){
    ms.forEach(function(m){
        if (m.type === 'characterData') {
            translateNode(m.target);
        } else {
            m.addedNodes.forEach(function(n){
                translateNode(n);
                if(n.nodeType!==1)return;
                if(n.shadowRoot)inject(n.shadowRoot);
                if(n.querySelectorAll)n.querySelectorAll('*').forEach(function(e){if(e.shadowRoot)inject(e.shadowRoot);});
            });
        }
    });
}).observe(document.documentElement,{childList:true,subtree:true,characterData:true});

// ═══ ESCÁNER GLOBAL: mensajes de error + acceso denegado ════════════════════════
// Diagnóstico definitivo (Playwright headless, 2026-07-09): el <p class="pf-c-alert__title">
// del error de login ("Error de autenticación.") queda con display:none SIN regla de
// hoja de estilo que lo justifique y SIN style inline — algo que sólo un display inline
// !important puede revertir (before:none → after:block confirmado). Por eso TODAS las
// correcciones vía CSS :not(...) fallaron: no compiten contra ese origen. Aquí forzamos
// la visibilidad del texto con estilo inline !important (el espejo de lo que hacía el
// viejo setupErrorCleaner para ocultarlo).
//
// Los MutationObserver NO cruzan límites de shadow DOM, y el error aparece DENTRO del
// shadow root del stage, así que un observer a nivel document no se entera: por eso
// hacemos polling continuo (barato, la pantalla de login es efímera) recorriendo TODOS
// los shadow roots. El mismo recorrido corrige el stage de acceso denegado
// (ak-flow-card, que inject() no visita): botón pegado + loop de "Ir al inicio".
(function(){
"use strict";
function showErrors(root){
    // Texto del error: forzar visible con inline !important (vence al display:none fantasma)
    root.querySelectorAll('.pf-c-alert__title,.pf-c-alert__description,.pf-c-form__helper-text.pf-m-error,p.pf-m-error').forEach(function(e){
        e.style.setProperty('display','block','important');
        e.style.setProperty('visibility','visible','important');
        e.style.setProperty('opacity','1','important');
        e.style.setProperty('height','auto','important');
        e.style.setProperty('overflow','visible','important');
        if(!e.style.color) e.style.setProperty('color','#151515','important');
    });
    // Contenedor de la alerta visible (sin tocar su display grid nativo)
    root.querySelectorAll('.pf-c-alert,.pf-c-form__alert').forEach(function(e){
        e.style.setProperty('visibility','visible','important');
        e.style.setProperty('opacity','1','important');
    });
    // REGLA CRÍTICA 2026-07-10: Ocultar "Inicia sesión para continuar a X"
    // SOLO en la pantalla de login — NUNCA en otras pantallas. Ese mensaje es
    // redundante con el botón "Iniciar sesión" y ocupa espacio valioso. Solo
    // aparece cuando entras vía una app (OAuth authorize a SonarQube, Plane…),
    // NO en el login plano — por eso hay que probarlo con un flujo de app real.
    // Ese <p> vive DENTRO del shadow root del stage de identificación, así que
    // hay que consultar en `root` (cada shadow root que recorre scan), NO en
    // `document` — sino nunca se alcanza. El selector completo
    // ".pf-c-login__main-body > p" SÍ es válido en element.querySelectorAll
    // (solo un combinator inicial suelto "> p" es inválido).
    root.querySelectorAll('.pf-c-login__main-body > p').forEach(function(p){
        // Solo ocultar EXACTAMENTE ese mensaje (texto trimmeado). No tocar otros
        // párrafos que podrían ser mensajes de error/ayuda de otras pantallas.
        if(p.textContent && p.textContent.trim().match(/^Inicia sesión para continuar/i)){
            p.style.setProperty('display','none','important');
            p.style.setProperty('height','0','important');
            p.style.setProperty('padding','0','important');
            p.style.setProperty('margin','0','important');
        }
    });
}
function scan(root){
    if(!root||!root.querySelectorAll)return;
    showErrors(root);
    if(root.host&&root.host.tagName&&root.host.tagName.toLowerCase()==='ak-stage-access-denied'){
        setupAccessDeniedStage(root);
    }
    var el=root.querySelector('ak-stage-access-denied');
    if(el&&el.shadowRoot)setupAccessDeniedStage(el.shadowRoot);
    root.querySelectorAll('*').forEach(function(n){if(n.shadowRoot)scan(n.shadowRoot);});
}
// Polling continuo cada 400ms (los observers no ven dentro de shadow roots).
setInterval(function(){scan(document);},400);
scan(document);
new MutationObserver(function(){scan(document);}).observe(document.documentElement,{childList:true,subtree:true});
})();
})();
</script>
{% endblock %}

{% block head %}
<script src="{% versioned_script 'dist/flow/FlowInterface-%v.js' %}" type="module"></script>
{% endblock %}

{% block body %}
<div id="cs-bg"></div>
<div id="cs-bg-overlay"></div>

<div id="cs-screen" class="cs-left">

    <!-- ── COLUMNA FORMULARIO ─────────────────────── -->
    <!-- Patrón footer-fijo: #cs-scroll-area scrollea (título → formulario →
         "¿Olvidaste tu contraseña?"); #cs-privacy queda anclado abajo, siempre
         visible, fuera del área que scrollea. -->
    <div id="cs-form-col">
        <div id="cs-scroll-area">
            <div id="cs-form-title" style="">CASMARTS<br>Core</div>
            <div id="cs-form-subtitle" style="">Smart Systems</div>

            <ak-skip-to-content></ak-skip-to-content>
            <ak-message-container></ak-message-container>
            <div id="cs-executor-wrap">
                <ak-flow-executor
                    slug="{{ flow.slug }}"
                    data-layout="{{ flow.layout|default:'stacked' }}"
                    loading
                >
                    {% include "base/placeholder.html" %}
                </ak-flow-executor>
            </div>
        </div>
        <span id="cs-privacy" onclick="csPdfOpen()">Aviso de Privacidad</span>
    </div>

    <!-- ── COLUMNA LOGOS ──────────────────────────── -->
    <div id="cs-logos-col" style="">
        <!-- Logo superior: imagen o texto -->
        <div id="cs-logo-top-wrap" style="display:flex; align-items:center; justify-content:center;">
            <img id="cs-logo-top" class="cs-logo"
                 src="/lm/api/v1/public/theme/default-authentication-flow/image/logo_top"
                 alt="Logo principal"
                 style="max-height:110px"
                 onerror="this.style.display='none'; if(this.parentElement) this.parentElement.style.display='none';">
        </div>
        <div id="cs-logo-top-text-wrap" style="display:none; align-items:center; justify-content:center;">
            <div id="cs-logo-top-text" class="cs-logo-text"></div>
        </div>

        <!-- Logo inferior: imagen o texto -->
        <div id="cs-logo-bot-wrap" style="display:flex; align-items:center; justify-content:center;">
            <img id="cs-logo-bot" class="cs-logo-bot"
                 src="/lm/api/v1/public/theme/default-authentication-flow/image/logo_bottom"
                 alt="Logo secundario"
                 onerror="this.style.display='none'; if(this.parentElement) this.parentElement.style.display='none';">
        </div>
        <div id="cs-logo-bot-text-wrap" style="display:none; align-items:center; justify-content:center;">
            <div id="cs-logo-bot-text" class="cs-logo-text-bot"></div>
        </div>
    </div>
    
    <!-- JS Failsafe to verify image loading status and hide broken logo containers -->
    <script>
      (function() {
        function checkLogos() {
          var topImg = document.getElementById('cs-logo-top');
          var botImg = document.getElementById('cs-logo-bot');
          if (topImg && (topImg.naturalWidth === 0 || topImg.src.indexOf('placeholder') !== -1 || !topImg.complete)) {
            topImg.style.display = 'none';
            var topWrap = document.getElementById('cs-logo-top-wrap');
            if (topWrap) topWrap.style.display = 'none';
          }
          if (botImg && (botImg.naturalWidth === 0 || botImg.src.indexOf('placeholder') !== -1 || !botImg.complete)) {
            botImg.style.display = 'none';
            var botWrap = document.getElementById('cs-logo-bot-wrap');
            if (botWrap) botWrap.style.display = 'none';
          }
        }
        window.addEventListener('load', checkLogos);
        setTimeout(checkLogos, 1000);
        setTimeout(checkLogos, 3000);
      })();
    </script>

</div>

<!-- Modal PDF -->
<div id="cs-pdf-modal">
    <div id="cs-pdf-box">
        <div id="cs-pdf-hdr">
            <span>Aviso de Privacidad</span>
            <button onclick="csPdfClose()">✕</button>
        </div>
        <div id="cs-pdf-body"></div>
    </div>
</div>

<script data-id="casmarts-theme-engine">
(function () {
    // /lm/ es proxied por Nginx desde auth.casmart.internal → casmarts-login-backend:8000
    // Esto evita el problema de certificado en Firefox, Edge y Opera
    const API_BASE  = '/lm';
    const FLOW_SLUG = '{{ flow.slug }}';
    const url       = new URL(window.location.href);
    const clientId  = url.searchParams.get('client_id') || '';

    function cssRgb(hex) {
        const h = hex.replace('#','');
        return `${parseInt(h.slice(0,2),16)}, ${parseInt(h.slice(2,4),16)}, ${parseInt(h.slice(4,6),16)}`;
    }

    function applyTheme(t) {
        const root = document.documentElement;
        root.style.setProperty('--cs-btn',       t.primary_color);
        root.style.setProperty('--cs-btn-hover',  t.hover_color);
        root.style.setProperty('--cs-panel-bg',   t.panel_bg_color);
        root.style.setProperty('--cs-card-bg',
            `rgba(${cssRgb(t.card_bg_color)}, ${t.form_opacity})`);

        /* fondo */
        const bg = document.getElementById('cs-bg');
        if (bg) {
            if (t.bg_type === 'color' && t.bg_flat_color) {
                bg.style.background = t.bg_flat_color;
                bg.style.backgroundImage = 'none';
            } else if (t.bg_type === 'image' && t.has_bg_image) {
                const imgUrl = `${API_BASE}/api/v1/public/theme/${FLOW_SLUG}/image/bg_image${clientId ? '?app='+clientId : ''}`;
                bg.style.backgroundImage = `url(${imgUrl})`;
            } else {
                bg.style.background = `linear-gradient(135deg, ${t.bg_gradient_from} 0%, ${t.bg_gradient_to} 100%)`;
                bg.style.backgroundImage = '';
            }
            bg.style.opacity = t.bg_opacity;
        }

        /* logos panel background, height and visibility */
        const logosCol = document.getElementById('cs-logos-col');
        if (logosCol) {
            const rgb = cssRgb(t.panel_bg_color);
            logosCol.style.background = `rgba(${rgb}, ${t.logos_opacity})`;
            logosCol.style.height = '';
            logosCol.style.maxHeight = '';
            logosCol.style.alignSelf = '';
            logosCol.style.display = t.show_logos_panel !== false ? '' : 'none';
        }

        /* form col background and height */
        const formCol = document.getElementById('cs-form-col');
        if (formCol) {
            formCol.style.background = `rgba(${cssRgb(t.card_bg_color)}, ${t.form_opacity})`;
            formCol.style.height = '';
            formCol.style.maxHeight = '';
        }

        /* layout and screen card height overrides */
        const screen = document.getElementById('cs-screen');
        if (screen) {
            screen.className = `cs-${t.layout_position}`;
            const targetHeight = t.form_height_pct || t.logos_height_pct;
            if (targetHeight) {
                screen.style.height = `${targetHeight}vh`;
                screen.style.maxHeight = `${targetHeight}vh`;
            } else {
                screen.style.height = '';
                screen.style.maxHeight = '';
            }
        }

        /* logo top: imagen o texto */
        const topWrap      = document.getElementById('cs-logo-top-wrap');
        const topImg       = document.getElementById('cs-logo-top');
        const topTextWrap  = document.getElementById('cs-logo-top-text-wrap');
        const topTextEl    = document.getElementById('cs-logo-top-text');
        if (t.has_logo_top && topImg) {
            topImg.src = `${API_BASE}/api/v1/public/theme/${FLOW_SLUG}/image/logo_top${clientId ? '?app='+clientId : ''}`;
            if (topWrap) topWrap.style.display = 'flex';
            if (topTextWrap) topTextWrap.style.display = 'none';
        } else if (t.logo_top_text) {
            if (topWrap) topWrap.style.display = 'none';
            if (topTextWrap) topTextWrap.style.display = 'flex';
            if (topTextEl) topTextEl.innerHTML = t.logo_top_text;
        } else {
            if (topWrap) topWrap.style.display = 'none';
            if (topTextWrap) topTextWrap.style.display = 'none';
        }

        /* logo bottom: imagen o texto */
        const botWrap      = document.getElementById('cs-logo-bot-wrap');
        const botImg       = document.getElementById('cs-logo-bot');
        const botTextWrap  = document.getElementById('cs-logo-bot-text-wrap');
        const botTextEl    = document.getElementById('cs-logo-bot-text');
        if (t.has_logo_bottom && botImg) {
            botImg.src = `${API_BASE}/api/v1/public/theme/${FLOW_SLUG}/image/logo_bottom${clientId ? '?app='+clientId : ''}`;
            if (botWrap) botWrap.style.display = 'flex';
            if (botTextWrap) botTextWrap.style.display = 'none';
        } else if (t.logo_bottom_text) {
            if (botWrap) botWrap.style.display = 'none';
            if (botTextWrap) botTextWrap.style.display = 'flex';
            if (botTextEl) botTextEl.innerHTML = t.logo_bottom_text;
        } else {
            if (botWrap) botWrap.style.display = 'none';
            if (botTextWrap) botTextWrap.style.display = 'none';
        }

        /* privacidad */
        const priv = document.getElementById('cs-privacy');
        if (priv) {
            priv.style.display = t.privacy_pdf_url ? 'block' : 'none';
            if (t.privacy_pdf_url) priv.dataset.url = t.privacy_pdf_url;
        }

        /* alineaciones en tarjeta form */
        const fTitle = document.getElementById('cs-form-title');
        if (fTitle) { fTitle.innerHTML = t.system_name; fTitle.style.textAlign = t.name_align; fTitle.style.display = t.show_system_name !== false ? 'block' : 'none'; }
        const fSub = document.getElementById('cs-form-subtitle');
        if (fSub) { fSub.innerHTML = t.system_subtitle; fSub.style.textAlign = t.subtitle_align; fSub.style.display = t.show_system_subtitle !== false ? 'block' : 'none'; }

        /* Idioma forzado (forceLocale) - redirección limpia */
        if (t.expansion_config && t.expansion_config.localization && t.expansion_config.localization.forceLocale) {
            const forced = t.expansion_config.localization.forceLocale;
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('locale') !== forced) {
                urlParams.set('locale', forced);
                window.location.search = urlParams.toString();
                return;
            }
        }

        /* Combinar traducciones personalizadas */
        if (t.custom_messages) {
            for (var k in t.custom_messages) {
                TRANSLATIONS[k.toLowerCase().trim().replace(/\s+/g, ' ')] = t.custom_messages[k];
            }
        }
        if (t.expansion_config && t.expansion_config.localization && t.expansion_config.localization.customTranslations) {
            var ct = t.expansion_config.localization.customTranslations;
            for (var k in ct) {
                TRANSLATIONS[k.toLowerCase().trim().replace(/\s+/g, ' ')] = ct[k];
            }
        }

        /* Traducir elementos existentes del DOM */
        const executorEl = document.querySelector('ak-flow-executor');
        if (executorEl && executorEl.shadowRoot) {
            translateNode(executorEl.shadowRoot);
        }
        translateNode(document.documentElement);

        /* inyección en shadow DOM: MutationObserver para máxima fiabilidad */
        csInjectShadow(t.primary_color, t.hover_color, {
            showForgot: t.show_forgot_password !== false,
            showPasswordToggle: t.show_password_toggle !== false,
            showFieldLabels: t.show_field_labels !== false,
            consentStage: t.expansion_config?.consentStage
        });
    }

    /* fetch per-app theme */
    const cacheKey = `cs:${FLOW_SLUG}:${clientId}`;
    try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) applyTheme(JSON.parse(cached));
    } catch(e) {}

    fetch(`${API_BASE}/api/v1/public/theme/${FLOW_SLUG}${clientId ? '?app='+clientId : ''}`)
        .then(r => r.ok ? r.json() : null)
        .then(t => {
            if (!t) return;
            try { sessionStorage.setItem(cacheKey, JSON.stringify(t)); } catch(e) {}
            if (t.is_custom === false) {
                /* Sin theme diseñado → ocultar layout custom, mostrar login nativo de Authentik */
                const exec = document.querySelector('ak-flow-executor');
                document.querySelectorAll('style[data-id="casmarts-branding"], #cs-bg, #cs-bg-overlay, #cs-screen').forEach(el => el.remove());
                document.body.style.cssText = '';
                document.documentElement.style.cssText = '';
                if (exec) {
                    document.body.appendChild(exec);
                    exec.style.cssText = '';
                    exec.classList.add('pf-c-login');
                }
                return;
            }
            applyTheme(t);
        })
        .catch(() => {});

    /* modal PDF */
    /* ── shadow DOM injection — sin loop infinito ───── */
    function csInjectShadow(primary, hover, opts) {
        if (!opts || typeof opts !== 'object') opts = {};
        const showForgot = opts.showForgot !== false;
        const showPasswordToggle = opts.showPasswordToggle !== false;
        const showFieldLabels = opts.showFieldLabels !== false;
        const CSS = `
            /* ── Anular CSS Custom Props en :host para cascada completa ── */
            :host {
                position: static !important;
                display: block !important;
                box-shadow: none !important;
                border: none !important;
                outline: none !important;
                /* Variables PatternFly que generan sombra/borde — heredan a todos los hijos */
                --pf-c-card--BoxShadow: none;
                --pf-c-card--BackgroundColor: transparent;
                --pf-c-card--BorderRadius: 0;
                --pf-c-login__main--BoxShadow: none;
                --pf-c-login__main--BackgroundColor: transparent;
                --pf-c-login__main--BorderRadius: 0;
                --pf-global--BoxShadow--sm: none;
                --pf-global--BoxShadow--sm-top: none;
                --pf-global--BoxShadow--md: none;
                --pf-c-login--BackgroundColor: transparent;
            }
            /* Pseudo-elementos que podrían aportar borde/sombra */
            .pf-c-login::before, .pf-c-login::after,
            .pf-c-card::before, .pf-c-card::after,
            .pf-c-login__main::before, .pf-c-login__main::after {
                display: none !important;
                box-shadow: none !important;
                border: none !important;
                content: none !important;
            }
            .pf-c-login {
                background: transparent !important;
                background-color: transparent !important;
                background-image: none !important;
                position: static !important;
                width: 100% !important;
                height: auto !important;
                min-height: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                transform: none !important;
                box-shadow: none !important;
                box-sizing: border-box !important;
            }
            /* Estilo de los paneles e interfaces */
            .pf-c-panel,
            .pf-c-panel__main,
            [class*="c-panel"] {
                position: static !important;
                transform: none !important;
                width: 100% !important;
                max-width: 100% !important;
                box-shadow: none !important;
                background: transparent !important;
                background-color: transparent !important;
                background-image: none !important;
                border: none !important;
                border-radius: 0 !important;
                outline: none !important;
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            /* Estilo del card/login principal con tamaño fijo, centrado y transparente */
            .pf-c-login__main,
            .pf-c-card {
                background: transparent !important;
                background-color: transparent !important;
                box-shadow: none !important;
                border: none !important;
                border-radius: 0 !important;
                width: 360px !important;
                max-width: 100% !important;
                min-height: auto !important;
                margin: 0 auto !important;
                padding: 0 !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
                align-items: stretch !important;
                box-sizing: border-box !important;
                transform: none !important;
            }
            /* Restaurar padding al body del formulario y forzar ancho total */
            .pf-c-login__main-body, [class*="main-body"] {
                padding: 0 !important;
                background: transparent !important;
                width: 100% !important;
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
            }
            /* ── Ocultar cabecera nativa (título, brand) ── */
            .pf-c-login__main-header,
            [class*="main-header"],
            ak-brand,
            .pf-c-brand,
            h1, h2,
            .pf-c-title,
            [class*="__header"],
            [slot="description"],
            ak-stage-identification p:not(.pf-c-form__helper-text):not(.pf-c-alert__title):not(.pf-c-alert__description):not([class*="alert"]):not([class*="error"]),
            .pf-c-login__main-body > p:not(.pf-c-alert__title):not(.pf-c-alert__description):not([class*="alert"]):not([class*="error"]) {
                display: none !important;
                height: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                overflow: hidden !important;
            }
            .pf-c-login__footer {
                display: none !important;
                height: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                overflow: hidden !important;
            }
            /* ── Ocultar locale/language switcher ── */
            ak-locale-select,
            [class*="locale-select"],
            [class*="locale_select"],
            [id*="locale"] {
                display: none !important;
            }
            /* ── Cuerpo del formulario ── */
            .pf-c-login__main-body, [class*="main-body"] {
                padding: 0 !important;
                background: transparent !important;
                background-color: transparent !important;
            }
            .pf-c-form__group, [class*="form__group"] {
                margin-bottom: 0.65rem !important;
            }
            /* ── Inputs con estilo redondeado ── */
            .pf-c-form-control,
            input:not([type="submit"]):not([type="button"]):not([type="checkbox"]):not([type="radio"]):not([type="range"]) {
                padding: 0.55rem 0.85rem !important;
                border-radius: 8px !important;
                border: 1.5px solid rgba(0,0,0,0.15) !important;
                background: rgba(255,255,255,0.8) !important;
                box-shadow: none !important;
                font-size: 0.9rem !important;
                transition: border-color 0.2s, box-shadow 0.2s !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }
            .pf-c-form-control:focus,
            input:not([type="submit"]):not([type="button"]):not([type="checkbox"]):not([type="radio"]):not([type="range"]):focus {
                border-color: ${primary} !important;
                box-shadow: 0 0 0 3px ${primary}33 !important;
                outline: none !important;
            }
            /* ── Corrección de diseño e integración del Ojo de Contraseña (input-group) ── */
            .pf-c-input-group {
                display: flex !important;
                width: 100% !important;
            }
            .pf-c-input-group > .pf-c-form-control,
            .pf-c-input-group > input {
                flex: 1 1 auto !important;
                width: auto !important;
                min-width: 0 !important;
                border-top-right-radius: 0 !important;
                border-bottom-right-radius: 0 !important;
            }
            .pf-c-input-group > .pf-c-button,
            .pf-c-input-group > button {
                border-top-left-radius: 0 !important;
                border-bottom-left-radius: 0 !important;
                border-top-right-radius: 8px !important;
                border-bottom-right-radius: 8px !important;
                border: 1.5px solid rgba(0,0,0,0.15) !important;
                border-left: none !important;
                background: rgba(255,255,255,0.8) !important;
                padding: 0 0.85rem !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }
            /* ── Footer "¿Olvidaste tu contraseña?" ── */
            .pf-c-login__main-footer, [class*="main-footer"] {
                ${showForgot ? '' : 'display: none !important;'}
                padding: 0 !important;
                margin-top: 0.75rem !important;
                background: transparent !important;
                background-color: transparent !important;
            }
            /* ── Botón primario ── */
            .pf-c-button.pf-m-primary, button[type="submit"] {
                background-color: ${primary} !important;
                border-color: ${primary} !important;
                border-radius: 8px !important;
                font-weight: 600 !important;
                padding: 0.6rem 1.2rem !important;
                width: 100% !important;
                box-shadow: none !important;
                text-shadow: none !important;
            }
            .pf-c-button.pf-m-primary:hover, button[type="submit"]:hover {
                background-color: ${hover} !important;
                border-color: ${hover} !important;
                box-shadow: none !important;
            }
            .pf-c-button.pf-m-primary:focus, button[type="submit"]:focus {
                box-shadow: 0 0 0 3px ${primary}40 !important;
                outline: none !important;
            }
            a { color: ${primary} !important; }
            .pf-c-form__label-text { color: rgba(0,0,0,0.7) !important; font-size: 0.85rem !important; }
            /* ── Visibilidad del mensaje de error de login ──────────────────────
               En este Authentik (2026.2) el error NO es un .pf-c-alert: el stage lo
               renderiza como <p> plano dentro de <ak-empty-state ...><div slot="body">.
               Las reglas de arriba ocultan <p> sin clase (para suprimir el subtítulo
               redundante del stage), lo que también tragaba este <p>. Este override,
               de mayor especificidad, lo vuelve a mostrar. El .pf-c-form__helper-text
               .pf-m-error cubre además el error a nivel de campo. */
            ak-empty-state [slot="body"], ak-empty-state [slot="body"] * ,
            ak-empty-state [slot="body"] p,
            .pf-c-form__helper-text.pf-m-error, p.pf-m-error, [class*="error"] {
                display: revert !important;
                visibility: visible !important;
                opacity: 1 !important;
                height: auto !important;
                overflow: visible !important;
            }
            ak-empty-state [slot="body"] p, .pf-c-form__helper-text.pf-m-error {
                color: #b1151c !important;
                font-size: 0.9rem !important;
            }
            /* ── Toggle visibilidad de contraseña ── */
            .pf-c-input-group > button,
            .pf-c-input-group .pf-c-button.pf-m-control,
            button[aria-label*="assword"] {
                ${showPasswordToggle ? '' : 'display: none !important;'}
            }
            /* ── Etiquetas de campo ── */
            .pf-c-form__label,
            label.pf-c-form__label {
                ${showFieldLabels ? '' : 'display: none !important;'}
            }
        `;
        // processRoot inyecta/actualiza el CSS en cada shadow root recursivamente
        // _done previene loops infinitos dentro de una misma llamada a csInjectShadow
        const _done = new WeakSet();

        function processRoot(root) {
            if (_done.has(root)) return;
            _done.add(root);
            // ACTUALIZAR si ya existe — crítico para cross-browser (2ª llamada con colores reales)
            const existing = root.querySelector('#cs-theme');
            if (existing) {
                existing.textContent = CSS;
            } else {
                const s = document.createElement('style');
                s.id = 'cs-theme';
                s.textContent = CSS;
                root.appendChild(s);
            }

            // Ajustar Consentimiento si aplica
            const consent = root.querySelector('ak-stage-consent') || (root.host?.tagName?.toLowerCase() === 'ak-stage-consent' ? root : null);
            if (consent && opts.consentStage) {
                const cRoot = consent.shadowRoot || consent;
                const cStage = opts.consentStage;
                // Mostrar/ocultar icono de app
                const icon = cRoot.querySelector('.ak-brand, ak-brand, img');
                if (icon) {
                    icon.style.display = cStage.showAppIcon !== false ? '' : 'none';
                }
                // Términos y Condiciones / Aviso de Privacidad
                const terms = cStage.termsAndPrivacyLinks?.terms;
                const privacy = cStage.termsAndPrivacyLinks?.privacy;
                if ((terms || privacy) && !cRoot.querySelector('#cs-consent-links')) {
                    const linksDiv = document.createElement('div');
                    linksDiv.id = 'cs-consent-links';
                    linksDiv.style.cssText = 'text-align: center; font-size: 0.82rem; margin: 1rem 0; width: 100%; display: block;';
                    let html = '';
                    if (terms) html += `<a href="${terms}" target="_blank" style="color: ${primary} !important; text-decoration: underline; font-weight: 500;">Términos de Servicio</a>`;
                    if (terms && privacy) html += ' | ';
                    if (privacy) html += `<a href="${privacy}" target="_blank" style="color: ${primary} !important; text-decoration: underline; font-weight: 500;">Aviso de Privacidad</a>`;
                    linksDiv.innerHTML = html;
                    const actions = cRoot.querySelector('.pf-c-form__group.pf-m-action, button, .pf-c-button');
                    if (actions) {
                        actions.parentNode.insertBefore(linksDiv, actions);
                    }
                }
            }

            // Escanear shadow roots anidados ya existentes
            root.querySelectorAll('*').forEach(el => {
                if (el.shadowRoot) processRoot(el.shadowRoot);
            });
            // Cada shadow root tiene su propio observer (subtree:true no cruza shadow boundaries)
            new MutationObserver(mutations => {
                mutations.forEach(m => m.addedNodes.forEach(n => {
                    if (n.nodeType !== 1) return;
                    if (n.shadowRoot) processRoot(n.shadowRoot);
                    n.querySelectorAll('*').forEach(el => {
                        if (el.shadowRoot) processRoot(el.shadowRoot);
                    });
                }));
            }).observe(root, { childList: true, subtree: true });
        }

        function tryExec() {
            const exec = document.querySelector('ak-flow-executor');
            if (!exec || !exec.shadowRoot) return false;
            processRoot(exec.shadowRoot);
            return true;
        }

        if (!tryExec()) {
            // Observer en body para cuando el elemento aparezca
            const obs = new MutationObserver((_, o) => { if (tryExec()) o.disconnect(); });
            obs.observe(document.body, { childList: true, subtree: true });
        }

        // Polling fase 1: 50ms × 20 = 1s (captura renders rápidos de Firefox/Edge)
        let _p1 = 0;
        const _t1 = setInterval(() => {
            const exec = document.querySelector('ak-flow-executor');
            if (exec && exec.shadowRoot) processRoot(exec.shadowRoot);
            if (++_p1 >= 20) clearInterval(_t1);
        }, 50);
        // Polling fase 2: 300ms × 16 = ~5s adicionales (fallback)
        let _p2 = 0;
        const _t2 = setInterval(() => {
            const exec = document.querySelector('ak-flow-executor');
            if (exec && exec.shadowRoot) processRoot(exec.shadowRoot);
            if (++_p2 >= 16) clearInterval(_t2);
        }, 300);

        // customElements.whenDefined: trigger confiable cuando el componente esté disponible
        if (typeof customElements !== 'undefined' && customElements.whenDefined) {
            customElements.whenDefined('ak-flow-executor').then(() => tryExec()).catch(() => {});
        }
    }

    // ── INYECCIÓN INMEDIATA (Firefox/Edge) ──────────────────────────────────
    // Se ejecuta SIN esperar al API fetch — usa colores del tema global (Jinja2)
    // Cuando applyTheme() reciba los colores reales, processRoot actualizará el CSS
    csInjectShadow('#2d5580', '#244466', {
        showForgot: true,
        showPasswordToggle: true,
        showFieldLabels: true
    });

    window.csPdfOpen = function() {
        const m = document.getElementById('cs-pdf-modal');
        if (!m) return; m.classList.add('open');
        const pdfUrl = document.getElementById('cs-privacy')?.dataset?.url;
        const b = document.getElementById('cs-pdf-body');
        b.innerHTML = pdfUrl
            ? `<embed src="${pdfUrl}#toolbar=1" type="application/pdf" width="100%" height="100%">`
            : '<div style="padding:2rem;color:#666">Sin documento.</div>';
    };
    window.csPdfClose = function() {
        const m = document.getElementById('cs-pdf-modal');
        if (m) m.classList.remove('open');
        const b = document.getElementById('cs-pdf-body');
        if (b) b.innerHTML = '';
    };
    document.addEventListener('keydown', e => { if (e.key==='Escape') window.csPdfClose(); });
})();
</script>
