{% extends "base/skeleton.html" %}
{% load i18n %}
{% load static %}
{% load authentik_core %}

{% block head_before %}
{{ block.super }}
<link rel="prefetch" href="{{ flow_background_url }}" />
{% if flow.compatibility_mode and not inspector %}
<script data-id="shady-dom">
    "use strict";
    window.ShadyDOM = window.ShadyDOM || {}
    window.ShadyDOM.force = true
</script>
{% endif %}
{% include "base/header_js.html" %}
<script data-id="force-spanish-locale">
    "use strict";
    if (window.authentik) {
        window.authentik.locale = "es";
    }
</script>
<script data-id="flow-config">
    "use strict";
    window.authentik.flow = { "layout": "{{ flow.layout }}" };
</script>
<link rel="stylesheet" type="text/css" href="{% versioned_script 'dist/styles/static-%v.css' %}" />
<style data-id="casmarts-branding">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

/* ── RESET NATIVO AUTHENTIK ─────────────────────────── */
html {
    height: 100%;
    background: transparent !important;
}
body {
    margin: 0; padding: 0;
    height: 100vh; width: 100vw;
    overflow: hidden !important;
    background: transparent !important;
    background-image: none !important;
    display: flex;
    align-items: stretch;
}
:root {
    --ak-global--background-image: none !important;
    --cs-btn:        #2d5580;
    --cs-btn-hover:  #244466;
    --cs-panel-bg:   #ffffff;
    --cs-card-bg:    rgba(255, 255, 255, 0.75);
    --cs-font: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --cs-error-text: #b1151c;
    --cs-text-primary: #111;
    --cs-text-secondary: #555;
}

@media (prefers-color-scheme: dark) {
    :root {
        --cs-panel-bg:   #1a1a1a;
        --cs-card-bg:    rgba(30, 30, 30, 0.85);
        --cs-error-text: #ff6b6b;
        --cs-text-primary: #f0f0f0;
        --cs-text-secondary: #aaa;
    }
}

/* ── FONDO COMPLETO ─────────────────────────────────── */
#cs-bg {
    position: fixed; inset: 0; z-index: 0;
    background-size: cover; background-position: center;
    
    background-image: url('/lm/api/v1/public/theme/default-authentication-flow/image/bg_image');
    
    opacity: 1.0;
}
#cs-bg-overlay {
    position: fixed; inset: 0; z-index: 1;
    background: rgba(0,0,0,0.15); pointer-events: none;
}

@media (prefers-color-scheme: dark) {
    #cs-bg-overlay {
        background: rgba(0,0,0,0.4);
    }
}

/* ── TARJETA UNIFICADA (PANTALLA PRINCIPAL) ─────────────────── */
#cs-screen {
    display: flex;
    align-items: stretch;
    justify-content: flex-start;
    font-family: var(--cs-font);
    z-index: 2;
    
    /* Estilo de tarjeta única unificada */
    background: transparent !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: 24px;
    box-shadow: 0 24px 64px rgba(0, 42, 76, 0.12), 0 8px 24px rgba(0, 42, 76, 0.06);
    overflow: hidden;

    /* Dimensiones balanceadas y perfectas para evitar desbordamientos */
    width: 820px;
    max-width: 90vw;
    height: 70vh;
    min-height: 560px;
    max-height: 620px;
    transition: all 0.3s ease;
    
    /* Centrado vertical absoluto en pantalla */
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
}

/* Dirección y posicionamiento horizontal del card unificado */
#cs-screen.cs-left {
    flex-direction: row;
    left: 6vw !important;
}
#cs-screen.cs-right {
    flex-direction: row-reverse;
    left: auto !important;
    right: 6vw !important;
}
#cs-screen.cs-center {
    flex-direction: row;
    justify-content: center;
    width: 820px; /* Mantener ambos paneles unidos al centro */
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
}

/* ── PANEL FORMULARIO (MITAD DEL CARD) ──────────────────
   Contenedor SIN scroll: aloja el área scrolleable (#cs-scroll-area) y el
   footer fijo (#cs-privacy). El scroll vive en el área interna, no aquí. */
#cs-form-col {
    width: 50%;
    min-width: 325px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    overflow: hidden;
    background: var(--cs-card-bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-radius: 0;
    box-shadow: none;
    height: 100%;
    min-height: 0;
}

/* ── ÁREA SCROLLEABLE (título → formulario → "¿Olvidaste tu contraseña?") ──
   Crece para ocupar el espacio disponible del panel y scrollea cuando su
   contenido excede esa altura. #cs-privacy queda fuera, anclado abajo. */
#cs-scroll-area {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 24px 28px 8px 28px;
}
#cs-scroll-area::-webkit-scrollbar {
    width: 6px;
}
#cs-scroll-area::-webkit-scrollbar-track {
    background: transparent;
}
#cs-scroll-area::-webkit-scrollbar-thumb {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 10px;
}
#cs-scroll-area::-webkit-scrollbar-thumb:hover {
    background-color: rgba(0, 0, 0, 0.3);
}

/* Centro: ambos paneles mantienen 50%/flex:1 — no override */

/* ── TÍTULOS EN TARJETA FORM (siempre visibles) ─────── */
#cs-form-title {
    font-weight: 800; font-size: 1.8rem; line-height: 1.2;
    color: var(--cs-text-primary) !important;
    text-align: center;
    margin-bottom: 4px;
    width: 100%;
    position: relative;
    z-index: 100;
    flex-shrink: 0;
    display: block !important;
    visibility: visible !important;
    min-height: 2rem;
}
#cs-form-subtitle {
    font-size: 0.9rem; color: var(--cs-text-secondary) !important;
    text-align: center;
    margin-bottom: 28px;
    width: 100%;
    position: relative;
    z-index: 100;
    flex-shrink: 0;
    display: block !important;
    visibility: visible !important;
}

/* ── WRAPPER del executor ─────────────────────────────
   CRÍTICO (2026-07-10): flex:0 0 auto — el wrap DEBE medir su contenido real.
   Con flex:1 1 0 el wrap absorbía "el espacio restante" y se comprimía a una
   caja más chica que el formulario; como overflow es visible, el form se
   desbordaba por fuera y (a) el scroll de #cs-form-col nunca se activaba —la
   suma de hijos flex "cabía"— y (b) #cs-privacy se posicionaba sobre la caja
   comprimida, superponiéndose al link "¿Olvidaste tu contraseña?" del form.
   Al medir su contenido, el form empuja hacia abajo: privacy queda debajo y
   cuando el total excede la altura del card, overflow-y:auto activa el scroll.
   NO volver a poner flex:1 1 0 (regresión recurrente). */
#cs-executor-wrap {
    flex: 0 0 auto;
    min-height: 0;
    overflow: visible;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    /* Crea containing block propio — contiene position:fixed del shadow DOM en Firefox/Edge */
    transform: translateZ(0);
    isolation: isolate;
    contain: layout style;
    padding-bottom: 24px;
    margin-bottom: 12px;
}

/* ── ak-flow-executor: bloque puro, sin layout Patternfly ── */
ak-flow-executor {
    display: block !important;
    position: static !important;
    inset: unset !important;
    width: 100% !important;
    max-width: 100% !important;
    min-height: 0 !important;
    height: auto !important;
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
    /* CSS vars piercing shadow DOM — funcionan en TODOS los navegadores sin JS */
    --pf-c-login--BackgroundColor: transparent;
    /* CRÍTICO: limita max-width del form al 100% del contenedor (sin esto el form se desborda) */
    --pf-c-login__main--MaxWidth: 100%;
    --pf-c-login__main--BackgroundColor: transparent;
    --pf-c-login__main--BoxShadow: none;
    --pf-c-login__main-body--PaddingTop: 0;
    --pf-c-login__main-body--PaddingBottom: 0;
    --pf-c-card--BackgroundColor: transparent;
    --pf-c-card--BoxShadow: none;
    --pf-c-card--first-child--PaddingTop: 0;
    --pf-c-card--child--PaddingRight: 0;
    --pf-c-card--child--PaddingBottom: 0;
    --pf-c-card--child--PaddingLeft: 0;
    --pf-c-button--m-primary--BackgroundColor: var(--cs-btn);
    --pf-c-button--m-primary--hover--BackgroundColor: var(--cs-btn-hover);
    --pf-global--primary-color--100: var(--cs-btn);
    --pf-global--primary-color--200: var(--cs-btn-hover);
    --pf-global--link--Color: var(--cs-btn);
}
/* También en todos los stages — CSS vars piercing shadow DOM */
ak-stage-identification, ak-stage-password,
ak-stage-authenticator-totp, ak-stage-authenticator-validate,
ak-stage-consent, ak-stage-user-write,
[class*="ak-stage"] {
    --pf-c-login__main--MaxWidth: 100%;
    --pf-c-login__main--BackgroundColor: transparent;
    --pf-c-login__main--BoxShadow: none;
    --pf-c-card--BackgroundColor: transparent;
    --pf-c-card--BoxShadow: none;
}

/* Ocultar locale switcher nativo (se renderiza fuera del shadow DOM) */
ak-locale-select {
    display: none !important;
}
ak-skip-to-content {
    position: absolute !important;
    width: 1px !important; height: 1px !important;
    overflow: hidden !important;
    clip: rect(0,0,0,0) !important;
    flex-shrink: 0;
}

/* ── PANEL LOGOS (MITAD OPUESTA DEL CARD) ────────────── */
#cs-logos-col {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 36px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    height: 100%;
    
    /* Divisor sutil entre los paneles unificados */
    border-left: 1px solid rgba(255, 255, 255, 0.4);
}
#cs-screen.cs-right #cs-logos-col {
    border-left: none;
    border-right: 1px solid rgba(255, 255, 255, 0.4);
}


/* ── RESPONSIVIDAD (TABLET) ────────────────────────────
   Breakpoint intermedio para tablets/ventanas medianas (820px → 600px ancho) */
@media (max-width: 920px) {
    #cs-screen {
        width: 95vw;
        max-width: 600px;
        height: 90vh !important;
        min-height: 500px !important;
        max-height: 90vh !important;
        overflow: hidden !important;
        flex-direction: column !important;
        align-items: center;
    }
    #cs-form-col {
        width: 100% !important;
        flex: 1 1 auto !important;
        overflow: hidden !important;
        max-width: 100% !important;
        padding: 0 !important;
        min-height: 0 !important;
    }
    #cs-scroll-area {
        padding: 2rem 1.5rem 8px 1.5rem !important;
    }
    #cs-privacy {
        padding: 12px 1.5rem 16px 1.5rem !important;
    }
    #cs-logos-col {
        width: 100% !important;
        height: auto !important;
        max-height: 200px !important;
        padding: 1rem !important;
    }
    #cs-screen.cs-left #cs-logos-col,
    #cs-screen.cs-right #cs-logos-col {
        border-left: none !important;
        border-right: none !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.4);
    }
}

/* ── RESPONSIVIDAD (MOBILE) ────────────────────────────
   Breakpoint bajo: solo pantallas MUY pequeñas (< 480px ancho real) */
@media (max-width: 480px) {
    #cs-screen {
        width: 95vw;
        max-width: 380px;
        height: 95vh !important;
        min-height: 450px !important;
        max-height: 95vh !important;
        overflow: hidden !important;
        flex-direction: column !important;
        align-items: center;
        padding: 1rem !important;
    }
    #cs-form-col {
        width: 100% !important;
        flex: 1 1 auto !important;
        overflow: hidden !important;
        padding: 0 !important;
        min-height: 0 !important;
    }
    #cs-scroll-area {
        padding: 1rem 1rem 8px 1rem !important;
    }
    #cs-privacy {
        padding: 10px 1rem 14px 1rem !important;
    }
    #cs-logos-col {
        width: 100% !important;
        height: auto !important;
        max-height: 150px !important;
        padding: 0.5rem !important;
    }
    #cs-form-title {
        font-size: 1.4rem !important;
    }
    #cs-form-subtitle {
        font-size: 0.85rem !important;
        margin-bottom: 24px !important;
    }
}

@media (max-width: 480px) {
    #cs-form-subtitle {
        margin-bottom: 20px !important;
    }
}


/* ── LOGOS ──────────────────────────────────────────── */
.cs-logo { max-height: 110px; max-width: 340px; object-fit: contain; }
.cs-logo-bot { max-height: 80px; max-width: 300px; object-fit: contain; }
.cs-logo[src*="broken"], .cs-logo-bot[src*="broken"], .cs-logo:not([src]), .cs-logo-bot:not([src]), .cs-logo[src=""], .cs-logo-bot[src=""] {
    display: none !important;
}

/* ── TEXTO DE LOGOS (panel derecho) ─────────────────── */
.cs-logo-text {
    font-weight: 800; font-size: 2rem; line-height: 1.2;
    color: #fff; text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    white-space: pre-line;
}
.cs-logo-text-bot {
    font-weight: 700; font-size: 1.5rem; line-height: 1.2;
    color: rgba(255,255,255,0.92); text-align: center;
    text-shadow: 0 1px 6px rgba(0,0,0,0.3);
}

/* ── TÍTULO / SUBTÍTULO (panel logos) ──────────────── */
#cs-title {
    font-weight: 800; font-size: 2.2rem; line-height: 1.15;
    color: #fff; text-align: center;
    text-shadow: 0 2px 10px rgba(0,0,0,0.4);
    margin-bottom: 6px;
}
#cs-subtitle {
    font-size: 0.95rem; color: rgba(255,255,255,0.85);
    text-align: center;
    text-shadow: 0 1px 4px rgba(0,0,0,0.3);
}

/* ── AVISO DE PRIVACIDAD (footer fijo, siempre visible) ──
   flex:0 0 auto — NUNCA scrollea; queda anclado al fondo del panel, separado
   del área scrolleable por un borde sutil. */
#cs-privacy {
    font-size: 0.78rem;
    text-align: center;
    cursor: pointer; text-decoration: underline;
    flex: 0 0 auto;
    width: 100%;
    padding: 14px 28px 18px 28px;
    margin: 0;
    display: block;
    color: rgba(0,0,0,0.45);
    /* SIN background propio: es una fila flex aparte (no se solapa con el área
       scrolleable), así hereda el fondo uniforme de #cs-form-col. Ponerle un
       var(--cs-card-bg) apila dos capas semitransparentes y se ve más blanco. */
    background: transparent;
}
#cs-privacy:hover { color: var(--cs-btn); }

/* ── MODAL PDF ──────────────────────────────────────── */
#cs-pdf-modal {
    display: none; position: fixed; inset: 0; z-index: 1000;
    background: rgba(0,0,0,0.7); align-items: center; justify-content: center;
}
#cs-pdf-modal.open { display: flex; }
#cs-pdf-box {
    background: #fff; border-radius: 14px;
    width: 80vw; height: 85vh;
    display: flex; flex-direction: column;
    overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}
#cs-pdf-hdr {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px; background: var(--cs-btn); color: #fff;
    font-weight: 700; font-size: 0.95rem;
}
#cs-pdf-hdr button { background: none; border: none; color: #fff; font-size: 1.4rem; cursor: pointer; }
#cs-pdf-body { flex: 1; overflow: hidden; display: flex; flex-direction: column; }
#cs-pdf-body embed { flex: 1; width: 100%; height: 100%; border: none; }
</style>

