# ------------------------------------------------------------------------------
# AUTHENTIK LOGIN MANAGER - ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------

# Database (PostgreSQL) Configuration — usar un rol de DML acotado a esta
# base (p.ej. theme_app_user), nunca el superusuario `admin` que usa
# Authentik: postgres/rules.md #4.2 ("nunca con migrator, postgres ni un
# superusuario"). Ver auditoria 2026-11-03 — `admin` fue rotado de ambos
# backends a un rol dedicado sin acceso a la base `authentik`.
POSTGRES_DB=authentik_login_manager
POSTGRES_USER=CHANGE_ME_SCOPED_DB_ROLE
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_HOST=casmarts-core-pgpool
POSTGRES_PORT=5432

# Async Database Connection URL
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_SCOPED_DB_ROLE:CHANGE_ME_SECURE_PASSWORD@casmarts-core-pgpool:5432/authentik_login_manager

# Cache Connection URL (Valkey)
VALKEY_URL=redis://casmarts-core-cache:6379/0

# Security (Administrative API Auth)
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# API Gateway & Client CORS Origins (Comma separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# URL pública del backend, usada al generar URLs absolutas de imágenes en el HTML desplegado a Authentik
# Debe ser accesible desde el navegador del usuario final (no un hostname interno de Docker)
PUBLIC_API_BASE_URL=https://login-manager.casmarts.internal

# Conexión real a Authentik (desplegar plantillas de email + recibir webhooks de eventos reales)
# AUTHENTIK_HOST: hostname interno de Docker del contenedor authentik-server (no el dominio público)
# AUTHENTIK_API_TOKEN: crear un token dedicado (intent=api) para esta integración, no reutilizar otros
AUTHENTIK_HOST=http://casmarts-core-authentik-server:9000
AUTHENTIK_API_TOKEN=
# Secreto compartido que Authentik debe enviar en el header X-Webhook-Secret
AUTHENTIK_WEBHOOK_SECRET=

# Frontend Environment Variables (Replicated in React bundle)
VITE_API_BASE_URL=https://loginmanager.casmart.internal
